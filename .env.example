# Same Neo4j instance the Python pipeline (policyPrism repo) populates.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

PORT=3000

# The Python RAG microservice (see policyPrism/pipeline/prism/rag/service.py).
# It owns embeddings (local model) and answer synthesis (MiniMax) - this backend
# just proxies /catalogue/semantic-search to it. Run it with:
#   uv run uvicorn prism.rag.service:app --port 8000
RAG_SERVICE_URL=http://localhost:8000
