{
  "name": "policy-prism-catalogue-service",
  "version": "0.1.0",
  "private": true,
  "description": "Clean Architecture TypeScript service exposing the Policy Prism regulatory catalogue (facets, search, provision detail) over the Neo4j graph the Python pipeline populates.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/web/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/web/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "neo4j-driver": "^5.24.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
